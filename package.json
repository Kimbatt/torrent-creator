{
    "name": "torrent-creator",
    "type": "module",
    "scripts": {
        "dev": "npm-run-all --parallel dev-vite check:watch",
        "dev-vite": "vite dev",
        "build": "vite build",
        "build:singlefile": "vite build --mode singlefile",
        "preview": "vite preview",
        "check": "svelte-check --tsconfig ./tsconfig.json",
        "check:watch": "svelte-check --tsconfig ./tsconfig.json --watch --preserveWatchOutput"
    },
    "devDependencies": {
        "@sveltejs/vite-plugin-svelte": "^7.3.1",
        "@types/jsdom": "^27.0.0",
        "jsdom": "^27.2.0",
        "npm-run-all": "^4.1.5",
        "oxfmt": "^0.74.0",
        "sass-embedded": "^1.93.2",
        "svelte": "^5.57.2",
        "svelte-check": "^4.3.3",
        "typescript": "^6.0.3",
        "vite": "^8.3.0"
    }
}
